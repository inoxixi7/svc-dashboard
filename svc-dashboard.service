[Unit]
Description=svc-dashboard - 本机监听服务一览 (localhost:8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Safe default: install this as a user service, not a root system service.
WorkingDirectory=%h/svc-dashboard
ExecStart=/usr/bin/python3 %h/svc-dashboard/dashboard.py --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
MemoryMax=512M
CPUQuota=40%
TasksMax=64

[Install]
WantedBy=default.target
